          "rawSql": "SELECT device_time AS \"When\", state AS \"State\", job_id AS \"Job\" FROM ( SELECT device_time, state, job_id, lag(state) OVER (ORDER BY device_time) AS state_before FROM mower_state WHERE mower_id = ${mower:sqlstring} AND $__timeFilter(device_time) ) AS states WHERE state IN ('Error', 'isLifted') AND state IS DISTINCT FROM state_before ORDER BY device_time DESC LIMIT 200"
